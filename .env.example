# Copy to .env and fill in. Never commit .env.

# LLM (Gemini Flash by default; provider is pluggable)
KUBESAGE_LLM_PROVIDER=google_genai
KUBESAGE_LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Database (docker compose Postgres, host port 5433)
DATABASE_URL=postgresql+psycopg://kubesage:kubesage@localhost:5433/kubesage

# Kubernetes
KUBESAGE_KUBE_CONTEXT=kind-kubesage
KUBESAGE_SANDBOX_NAMESPACE=kubesage-sandbox
# Every Kubernetes call impersonates this ServiceAccount (deploy/kubesage/rbac.yaml): read-only, no Secrets,
# writes only in the sandbox. Leave as is; an empty value would use the cluster-admin kubeconfig directly.
KUBESAGE_KUBE_IMPERSONATE=system:serviceaccount:kubesage-system:kubesage

# Lab registry (host-side endpoint) used to list image variants for switch_image_variant
KUBESAGE_REGISTRY_URL=http://localhost:5001

# Lab mode enables host-side node operations (docker exec ... crictl) for cold-start experiments.
# This is root access to kind nodes outside RBAC: local demo only.
KUBESAGE_LAB_MODE=true
